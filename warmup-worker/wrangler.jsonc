{
  // Worker Cloudflare che sveglia il servizio Render (piano free, spin-down
  // notturno) prima del cron principale delle 07:00 ora di Roma.
  // Indipendente dall'app Laravel: vive qui solo per versionarne il codice.
  "name": "studio-finance-warmup",
  "main": "src/index.js",
  "compatibility_date": "2024-11-01",
  "triggers": {
    // Cron in UTC (Cloudflare gira solo in UTC). Free = max 3 trigger.
    // 04:50 / 05:10 / 05:40 UTC = 06:50 / 07:10 / 07:40 ora di Roma (estate):
    // tre colpi a cavallo dell'avvio del cron principale.
    "crons": ["50 4 * * *", "10 5 * * *", "40 5 * * *"]
  }
}
